# Copy to .env.local for local dev. Never commit real values.

# Lead storage (preferred): Supabase project URL + service-role / secret key (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback lead storage: Postgres connection string for the insert-only `quiz_writer` role
# (used only when SUPABASE_SERVICE_ROLE_KEY is not set).
SUPABASE_DB_URL=

# Optional MailerLite sync
MAILERLITE_API_KEY=
# One group for everyone...
MAILERLITE_GROUP_ID=
# ...or one group per result type (takes precedence over MAILERLITE_GROUP_ID)
MAILERLITE_GROUP_BLOOD_DEFICIENCY=
MAILERLITE_GROUP_KIDNEY_YIN=
MAILERLITE_GROUP_KIDNEY_YANG=
MAILERLITE_GROUP_LIVER_QI_STAGNATION=
MAILERLITE_GROUP_DAMPNESS_ACCUMULATION=
MAILERLITE_GROUP_BLOOD_STASIS=

# Set to "true" to allow search engines to index the quiz (original Typeform had indexing off)
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SITE_URL=
